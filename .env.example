# Supabase (compte et synchronisation). Copier en `.env.local` pour le dev ; pour les
# builds EAS, ces variables viennent des variables d'environnement EAS (DEVELOPMENT.md).
# La clé publishable est publique par conception : la RLS protège les données.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Compte de dev (script `npm run seed:dev`, pas lu par l'app). Ne pas préfixer par
# EXPO_PUBLIC_ : ces valeurs ne doivent pas finir dans le bundle.
POSTKEEP_DEV_EMAIL=postkeep-dev@example.com
POSTKEEP_DEV_PASSWORD=
